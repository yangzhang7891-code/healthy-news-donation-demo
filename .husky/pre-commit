# poetry (pip install --user poetry) lands in ~/.local/bin, which a
# non-interactive hook shell doesn't have on PATH by default.
export PATH="$HOME/.local/bin:$PATH"

# Upstream's pre-commit hook runs the full Playwright e2e suite, which
# needs downloaded browser binaries (not present in this dev
# environment) and boots the entire dev server chain on every commit —
# too slow for the many small, granular commits this fork is
# deliberately made of. Fast Python tests give real per-commit
# feedback on the extraction code instead; the e2e suite still belongs
# in CI (Phase 4) as the thing that gates anything being "done."
cd packages/python && poetry run pytest tests/ -q
